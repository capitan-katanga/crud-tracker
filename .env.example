# Copiar a .env (gitignoreado; lo carga spring.config.import). Valores solo para desarrollo local.
# Formato .properties: sin comillas ni `export`. Una env var exportada pisa el valor de acá.

# Datasource: rol y schema `expense_ledger` del Postgres de tracker-infra (puerto 5332).
# La password es la misma EXPENSE_LEDGER_DB_PASSWORD del .env de tracker-infra.
EXPENSE_LEDGER_DB_URL=jdbc:postgresql://localhost:5332/ExpenseTracker?currentSchema=expense_ledger
EXPENSE_LEDGER_DB_USERNAME=expense_ledger
EXPENSE_LEDGER_DB_PASSWORD=expense-ledger-dev

# Pool HikariCP fijo (ADR-013): mínimo = máximo = EXPENSE_LEDGER_DB_POOL_SIZE. El rol tiene
# CONNECTION LIMIT = pool + 2, así que subirlo exige subir el límite en tracker-infra
# (postgres/init/02-services.sh) y en src/test/resources/testcontainers/init-expense-ledger.sql.
EXPENSE_LEDGER_DB_POOL_SIZE=10
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_KEEPALIVE_TIME_MS=300000
DB_POOL_LEAK_DETECTION_MS=30000
